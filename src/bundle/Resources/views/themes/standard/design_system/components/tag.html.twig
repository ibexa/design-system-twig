{% set tag_classes =
    html_cva(
        base: html_classes(
            'ids-tag',
            {
                'ids-tag--dark': isDark,
                'ids-tag--custom-colors': customTextColor and customBackgroundColor,
            },
        ),
        variants: {
            type: {
                primary: 'ids-tag--primary',
                success: 'ids-tag--success',
                info: 'ids-tag--info',
                warning: 'ids-tag--warning',
                error: 'ids-tag--error',
                neutral: 'ids-tag--neutral',
                'icon-tag': 'ids-tag--icon-tag',
                'primary-alt': 'ids-tag--primary-alt',
                'success-ghost': 'ids-tag--success-ghost',
                'error-ghost': 'ids-tag--error-ghost',
                'neutral-ghost': 'ids-tag--neutral-ghost',
            },
            size: {
                medium: 'ids-tag--medium',
                small: 'ids-tag--small',
            },
        },
    )
%}
{% set custom_colors_style = '' %}
{% if customTextColor and customBackgroundColor %}
    {% set custom_colors_style = '--ids-tag-custom-text-color: ' ~ customTextColor ~ '; --ids-tag-custom-bg-color: ' ~ customBackgroundColor ~ '; --ids-tag-custom-border-color: ' ~ customBorderColor|default(customTextColor) ~ ';' %}
{% endif %}
{% set tag_style = (custom_colors_style ~ ' ' ~ attributes.render('style')|default(''))|trim %}

<div
    class="{{
        tag_classes.apply(
            {
                type,
                size
            },
            attributes.render('class')
        )
    }}"
    {% if tag_style %}style="{{ tag_style }}"{% endif %}
    {{ attributes }}
>
    {% if is_ghost_type %}
        <div class="ids-tag__ghost-dot"></div>
    {% endif %}
    {% if icon %}
        <div class="ids-tag__icon">
            <twig:ibexa:icon name="{{ icon }}" size="small" />
        </div>
    {% endif %}
    <div class="ids-tag__content">
        {{ block('content') }}
    </div>
</div>
