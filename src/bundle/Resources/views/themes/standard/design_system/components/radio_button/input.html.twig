{% extends '@IbexaDesignSystemTwig/themes/standard/design_system/partials/base_choice_input.html.twig' %}

{% set class = html_classes(class, attributes.render('class') ?? '') %}

{% block content %}
    <input
        class="{{ class }}"
        {{
            attributes.defaults({
                checked,
                disabled,
                required,
                type,
                value,
            })
            .defaults(name is not null ? {
                name,
            } : {
            })
        }}
    />
{% endblock content %}
