{% trans_default_domain 'ibexa_design_system_twig' %}

{% set classes =
    html_classes(
        'ids-accordion',
        {
            'ids-accordion--is-expanded': initially_expanded
        },
        attributes.render('class') ?? ''
    )
%}

<div class="{{ classes }}">
    <div class="ids-accordion__header">
        <div class="ids-accordion__header-content">
            {% block header %}

            {% endblock header %}
        </div>
        <twig:ibexa:expander
            type="{{ expander_type }}"
            :hasIcon="expander_has_icon"
            :hasLabel="expander_has_label"
            :isExpanded="initially_expanded"
            collapseLabel="{{ expander_collapse_label ?: 'ibexa.expander.label.collapse'|trans|desc('Hide') }}"
            expandLabel="{{ expander_expand_label ?: 'ibexa.expander.label.expand'|trans|desc('Show') }}"
        />
    </div>
    <div class="ids-accordion__content">
        {% block content %}

        {% endblock content %}
    </div>
</div>

{{ encore_entry_script_tags('ibexa-design-system-accordion-js', null, 'ibexa') }}
