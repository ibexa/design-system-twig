{% set value = attributes.render('value') %}
{% set custom_init = attributes.render('data-ids-custom-init') is not null %}
{% set root_class = root_class|default('') %}

{% set input_classes =
    html_cva(
        base: html_classes(
            'ids-input',
            {
                'ids-input--disabled': disabled,
                'ids-input--error': error,
                'ids-input--required': required
            }
        ),
        variants: {
            type: {
                text: 'ids-input--text',
                password: 'ids-input--password',
                email: 'ids-input--email',
                number: 'ids-input--number',
                tel: 'ids-input--tel',
                search: 'ids-input--search',
                url: 'ids-input--url'
            },
            size: {
                medium: 'ids-input--medium',
                small: 'ids-input--small'
            }
        }
    )
%}

{% set clear_action %}
    {% if send_form_after_clearing %}
        <twig:ibexa:ui:clear_button
            :disabled="disabled"
            data-send-form-after-clearing
        />
    {% else %}
        <twig:ibexa:ui:clear_button :disabled="disabled" />
    {% endif %}
{% endset %}

{% set show_password_toggle = type == 'password' and not has_search_action %}
{% set show_search_action = has_search_action and type != 'password' %}

{% set password_action %}
    <button
        type="button"
        class="ids-btn ids-btn--tertiary-alt ids-btn--small ids-btn--icon-only ids-input-text__password-toggler"
        {% if disabled %}disabled{% endif %}
        aria-label="{{ 'ibexa.show-password.label'|trans({}, 'ibexa_design_system_twig')|desc('Toggle password visibility') }}"
        title="{{ 'ibexa.show-password.label'|trans({}, 'ibexa_design_system_twig')|desc('Toggle password visibility') }}"
    >
        <span class="ids-btn__icon">
            <span class="ids-input-text__password-icon ids-input-text__password-icon--show">
                <twig:ibexa:icon name="visibility" size="tiny-small" />
            </span>
            <span class="ids-input-text__password-icon ids-input-text__password-icon--hide" hidden>
                <twig:ibexa:icon name="visibility-hidden" size="tiny-small" />
            </span>
        </span>
    </button>
{% endset %}

{% set search_action %}
    <button
        type="{{ search_button_type }}"
        class="ids-btn ids-btn--tertiary-alt ids-btn--small ids-btn--icon-only ids-input-text__search-btn"
        {% if disabled %}disabled{% endif %}
        aria-label="{{ 'ibexa.search-button.label'|trans({}, 'ibexa_design_system_twig')|desc('Search') }}"
        title="{{ 'ibexa.search-button.label'|trans({}, 'ibexa_design_system_twig')|desc('Search') }}"
    >
        <span class="ids-btn__icon">
            <twig:ibexa:icon name="search" size="tiny-small" />
        </span>
    </button>
{% endset %}

{% set actions = [
    {
        id: 'clear',
        class: value is empty ? 'ids-input-text__action--hidden' : '',
        component: clear_action
    }
] %}

{% if show_password_toggle %}
    {% set actions = actions|merge([
        {
            id: 'password-toggle',
            component: password_action,
        }
    ]) %}
{% endif %}

{% if show_search_action %}
    {% set actions = actions|merge([
        {
            id: 'search',
            component: search_action,
        }
    ]) %}
{% endif %}

<div class="{{ html_classes('ids-input-text', root_class) }}"{{ custom_init ? ' data-ids-custom-init' : '' }}>
    <div class="ids-input-text__source">
        <input
            class="{{
                input_classes.apply(
                    {
                        type,
                        size
                    },
                    attributes.render('class')
                )
            }}"
            {{
                attributes.defaults({
                    type,
                    disabled,
                    required
                })
            }}
            value="{{ value }}"
        />
    </div>
    <div class="ids-input-text__actions">
        {%- for action in actions -%}
            <div class="{{ html_classes('ids-input-text__action', action.class|default('')) }}">
                {{- action.component|raw -}}
            </div>
        {%- endfor -%}
        {% if actions_after is not empty %}
            <div class="ids-input-text__action ids-input-text__action--custom">
                {{- actions_after|raw -}}
            </div>
        {% endif %}
    </div>
</div>
