{
    "name": "design-system-twig",
    "repository": "git@github.com:ibexa/design-system-twig.git",
    "private": true,
    "devDependencies": {
        "@ibexa/design-system": "https://github.com/ibexa/design-system",
        "@ibexa/eslint-config": "https://github.com/ibexa/eslint-config-ibexa#~v2.0.0",
        "@ibexa/ts-config": "https://github.com/ibexa/ts-config-ibexa#~v1.1.0"
    },
    "scripts": {
        "test": "yarn prettier-test && yarn eslint-test",
        "fix": "yarn prettier-test --write && yarn eslint-test --fix",
        "eslint-test": "eslint \"./src/bundle/Resources/**/*.{js,ts}\" \"./src/bundle/ui-dev/**/*.{js,ts,tsx}\" --no-error-on-unmatched-pattern",
        "prettier-test": "yarn prettier \"./src/bundle/Resources/**/*.{js,ts,scss}\" \"./src/bundle/ui-dev/**/*.{js,ts,tsx}\" --check --no-error-on-unmatched-pattern"
    },
    "packageManager": "yarn@1.22.22"
}
